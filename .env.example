# --- Next.js (copy to .env.local) -------------------------------------------
# Clerk (https://dashboard.clerk.com) - placeholders only
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Convex (written by `npx convex dev` into .env.local; shown here for reference)
# CONVEX_DEPLOYMENT=dev:your-deployment-name
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# --- Convex deployment env vars ----------------------------------------------
# These are NOT read from .env.local. Set them on the Convex deployment:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
#   npx convex env set LENDLOOP_HMAC_SECRET <openssl rand -hex 32>
#   npx convex env set N8N_WEBHOOK_URL http://localhost:5678/webhook/lendloop-loan-events
#   npx convex env set ADMIN_EMAILS you@example.com
# (listed here for documentation only)
