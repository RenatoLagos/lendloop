# Copy to .env.n8n (git-ignored) and fill in. Used by docker-compose.yml.

# Same value as the Convex env var LENDLOOP_HMAC_SECRET (openssl rand -hex 32)
# Leave blank until you generate it: n8n rejects every webhook while it is empty.
LENDLOOP_HMAC_SECRET=

# Convex HTTP actions base URL (NOT .convex.cloud). Copy NEXT_PUBLIC_CONVEX_SITE_URL
# from .env.local: regional deployments include the region, e.g.
# https://<deployment>.eu-west-1.convex.site
CONVEX_SITE_URL=https://your-deployment-name.convex.site

# Optional: Slack/Discord-style incoming webhook that receives error-workflow alerts
ALERT_WEBHOOK_URL=

# n8n basics
GENERIC_TIMEZONE=UTC
# Encrypts credentials stored in n8n. Generate once with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
